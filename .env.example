# SentinelLog Environment Configuration Example
APP_NAME=SentinelLog
APP_VERSION=2.4.0
ENVIRONMENT=development
DEBUG=false

# Security & Session Secrets
SECRET_KEY=generate_a_random_64_char_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Database Connection (SQLite default, PostgreSQL supported)
DATABASE_URL=sqlite:///./sentinel_log.db
# DATABASE_URL=postgresql://user:password@localhost:5432/sentinel_db

# File Storage
MAX_UPLOAD_SIZE_BYTES=52428800
UPLOAD_DIR=./uploads
REPORTS_DIR=./reports_storage

# Threat Intelligence (Disabled by default - zero leakage)
ENABLE_EXTERNAL_THREAT_INTEL=false
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=

# Detection Thresholds
BRUTE_FORCE_THRESHOLD=5
BRUTE_FORCE_WINDOW_MINUTES=10
PASSWORD_SPRAY_USER_THRESHOLD=3
PASSWORD_SPRAY_WINDOW_MINUTES=15
IMPOSSIBLE_TRAVEL_SPEED_KMH=900.0
